import Hashtree.Asm.X86

/-! `x86insncheck`: the model side of the per-instruction differential test of `Hashtree.Asm.X86`
against the CPU (`tools/x86_insn_diff.py`, `tools/x86_insn_harness.c`, `tools/x86_insn_compare.py`).

For test `t` and trial `k` the initial state is generated by splitmix64 seeded with
`t * 1000003 + k + 12345`, in the same order as the C harness: 32×16 vector lanes, 16 raw general
register values, the buffers of region 1 (4352 bytes), region 3 (stack, 4096 bytes, `rsp` at 2048)
and region 4 (`.rodata`, 256 bytes).  General registers are data or pointers/counts by the test's
kinds.  The instruction is executed once with `exec`; the output lists every location whose value
changed (vector lanes, general registers as 64-bit numbers, memory bytes; pointers are made
concrete with the native buffer addresses given on the command line) and the ten condition codes
`e ne l ge le g b ae be a` when the model has flags (`cc=-` when it does not).

    x86insncheck <trials> <base1> <base3> <base4> [--ymm] [first last]

`--ymm`: only the state visible on a CPU without AVX-512 (ymm0..15), and skip the AVX-512 tests. -/

open Hashtree.Asm Hashtree.Asm.X86

namespace X86InsnCheck

/-- How a general register is initialised from its raw random value. -/
inductive Kind where
  | dat
  | cnt
  | cm (m k : Nat)
  | ptr (r off : Nat)
  | pr (r m k : Nat)
  | cbig
  deriving Repr, Inhabited

structure Test where
  text : String
  insn : Instr
  kinds : List (Nat × Kind)
  avx512 : Bool
  deriving Inhabited

