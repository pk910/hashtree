def NB1 : Nat := 4352
def NB3 : Nat := 4096
def NB4 : Nat := 256
def SP0 : Nat := 2048

/-- splitmix64: (output, new state). -/
def nxt (x : UInt64) : UInt64 × UInt64 :=
  let x := x + 0x9e3779b97f4a7c15
  let z := (x ^^^ (x >>> 30)) * 0xbf58476d1ce4e5b9
  let z := (z ^^^ (z >>> 27)) * 0x94d049bb133111eb
  (z ^^^ (z >>> 31), x)

structure Init where
  v : Array (Array Nat)
  raw : Array Nat
  b1 : ByteArray
  b3 : ByteArray
  b4 : ByteArray

def fill (x : UInt64) (n : Nat) : ByteArray × UInt64 := Id.run do
  let mut x := x
  let mut b := ByteArray.emptyWithCapacity n
  for _ in [0:n / 8] do
    let (z, x') := nxt x
    x := x'
    for j in [0:8] do
      b := b.push (z >>> (8 * j).toUInt64).toUInt8
  return (b, x)

def genInit (t k : Nat) : Init := Id.run do
  let mut x : UInt64 := (t * 1000003 + k + 12345).toUInt64
  let mut v : Array (Array Nat) := #[]
  for _ in [0:32] do
    let mut row : Array Nat := #[]
    for _ in [0:16] do
      let (z, x') := nxt x
      x := x'
      row := row.push (z.toNat % 2 ^ 32)
    v := v.push row
  let mut raw : Array Nat := #[]
  for _ in [0:16] do
    let (z, x') := nxt x
    x := x'
    raw := raw.push z.toNat
  let (b1, x1) := fill x NB1
  let (b3, x3) := fill x1 NB3
  let (b4, _) := fill x3 NB4
  return { v, raw, b1, b3, b4 }

def kindVal (k : Kind) (r : Nat) : Val W32 Int :=
  let m := r / 4
  match k with
  | .dat => .num (BitVec.ofNat 32 r) (BitVec.ofNat 32 (r / 2 ^ 32))
  | .cnt => .ptr ⟨rNum, Int.ofNat (match r % 4 with
      | 0 => m % 48 | 1 => m % 4096 | 2 => m % 2 ^ 32 | _ => m % 2 ^ 62)⟩
  | .cm md mul => .ptr ⟨rNum, Int.ofNat ((r % md) * mul)⟩
  | .ptr reg off => .ptr ⟨reg, Int.ofNat off⟩
  | .pr reg md mul => .ptr ⟨reg, Int.ofNat ((r % md) * mul)⟩
  | .cbig => .ptr ⟨rNum, Int.ofNat (r ||| 2 ^ 63)⟩

def initState (t : Test) (ini : Init) : State W32 Int :=
  let g0 := (List.range 16).map fun i => kindVal .dat (ini.raw[i]!)
  let g1 := g0.set 4 (.ptr ⟨rStack, Int.ofNat SP0⟩)
  let g := t.kinds.foldl (fun g (i, k) => g.set i (kindVal k (ini.raw[i]!))) g1
  let vr := ini.v.toList.map fun row => row.toList.map fun w => BitVec.ofNat 32 w
  { gpr := g, vr := vr, flags := none, mem := [], pc := 0, halted := false, tail := none,
    err := none, assume := [] }

/-- The initial byte of a buffer location, if it is one. -/
def initByte (ini : Init) (r : Nat) (off : Int) : Option Nat :=
  let get (b : ByteArray) (n : Nat) := if 0 ≤ off ∧ off < n then some (b.get! off.toNat).toNat else none
  if r = 1 then get ini.b1 NB1 else if r = 3 then get ini.b3 NB3 else if r = 4 then get ini.b4 NB4 else none

/-- Initial memory: the three buffers; anything else is a pointer byte (reading it as data fails). -/
def mem0 (ini : Init) (a : Addr Int) : Cell W32 Int :=
  match initByte ini a.region a.off with
  | some b => .dat (BitVec.ofNat 32 b) 0
  | none => .pb ⟨99, 0⟩ 0

abbrev Bases := Nat × Nat × Nat

def concAddr (bs : Bases) (a : Addr Int) : Option Int :=
  match a.region with
  | 0 => some a.off
  | 1 => some (bs.1 + a.off)
  | 3 => some (bs.2.1 + a.off)
  | 4 => some (bs.2.2 + a.off)
  | _ => none

def u64 (x : Int) : Nat := (x % 2 ^ 64).toNat

def concVal (bs : Bases) : Val W32 Int → Option Nat
  | .num lo hi => some (hi.toNat * 2 ^ 32 + lo.toNat)
  | .ptr a => (concAddr bs a).map u64

def cellByte (bs : Bases) : Cell W32 Int → Option Nat
  | .dat x k => some (byteOf x k).toNat
  | .pb p k => (concAddr bs p).map fun v => (u64 v / 2 ^ (8 * k)) % 256

def hex (w n : Nat) : String :=
  let s := String.ofList (Nat.toDigits 16 n)
  String.ofList (List.replicate (w - s.length) '0') ++ s

def ccs : List CC := [.e, .ne, .l, .ge, .le, .g, .b, .ae, .be, .a]

/-- The changed locations after executing test `t` once from trial `k`'s initial state. -/
def runOne (bs : Bases) (ymm : Bool) (t : Test) (n k : Nat) : String := Id.run do
  let ini := genInit n k
  let s0 := initState t ini
  let s := exec 4 (mem0 ini) (fun _ => false) t.insn s0
  let mut out := s!"{n} {k}"
  let (nv, nl) := if ymm then (16, 8) else (32, 16)
  for r in [0:nv] do
    for l in [0:nl] do
      let a := ((s0.getV r).getD l 0).toNat
      let b := ((s.getV r).getD l 0).toNat
      if a ≠ b then out := out ++ s!" v{r}.{l}={hex 8 b}"
  for i in [0:16] do
    let a := concVal bs (s0.getG i)
    let b := concVal bs (s.getG i)
    if a ≠ b then out := out ++ s!" g{i}=" ++ (match b with | some v => hex 16 v | none => "?")
  -- memory: the written locations, sorted by region and offset
  let addrs := (s.mem.map (·.1)).eraseDups
  let addrs := addrs.toArray.qsort (fun a b => a.region < b.region || (a.region == b.region && a.off < b.off))
  for a in addrs do
    match initByte ini a.region a.off, readCell (mem0 ini) s a with
    | some b0, .ok c =>
      match cellByte bs c with
      | some b => if b ≠ b0 then out := out ++ s!" m{a.region}.{a.off}={hex 2 b}"
      | none => out := out ++ s!" m{a.region}.{a.off}=?"
    | _, _ => out := out ++ s!" OOB:{a.region}.{a.off}"
  if let some e := s.err then out := out ++ " err=" ++ e.replace " " "_"
  if s.pc ≠ 1 then out := out ++ s!" pc={s.pc}"
  match s.flags with
  | none => out := out ++ " cc=-"
  | some (a, b) =>
    out := out ++ " cc=" ++ String.ofList (ccs.map fun c =>
      match (ccCond c a b).decideC with
      | some true => '1' | some false => '0' | none => '?')
  return out

end X86InsnCheck

open X86InsnCheck in
def main (args : List String) : IO UInt32 := do
  match args with
  | trials :: b1 :: b3 :: b4 :: rest =>
    let ymm := rest.contains "--ymm"
    let rest := rest.filter (· != "--ymm")
    let (first, last) := match rest with
      | [f, l] => (f.toNat!, l.toNat!)
      | _ => (0, tests.size - 1)
    let bs : Bases := (b1.toNat!, b3.toNat!, b4.toNat!)
    let out ← IO.getStdout
    for n in [first:last + 1] do
      if h : n < tests.size then
        let t := tests[n]
        if ymm && t.avx512 then continue
        for k in [0:trials.toNat!] do
          out.putStrLn (runOne bs ymm t n k)
    return 0
  | _ =>
    IO.eprintln "usage: x86insncheck <trials> <base1> <base3> <base4> [--ymm] [first last]"
    return 2
