import Hashtree.Asm.X86SymW

/-!
# Our linux/amd64 wrapper `HashtreeHash` (wrapper_linux_amd64.s, assembled by go1.26)

Machine code (`go tool objdump`, results/wrappers/linux_amd64_objdump_go1.26.txt), ABI0 entry with
SP = `SPe` (return address into the autogenerated ABIInternal wrapper), arguments at `SPe + 8`
(output), `+ 16` (input), `+ 24` (count):

    0  MOVQ FS:-8, R14          -- g: a no-op under ABIInternal (R14 = g already)          [abstracted]
    1  LEAQ -0x788(SP), R12
    2  CMPQ R12, 0x10(R14)      -- stack check against g.stackguard0                        [abstracted]
    3  JBE morestack            -- assumed not taken (the morestack path is out of scope)
    4  PUSHQ BP
    5  MOVQ SP, BP
    6  SUBQ $0x800, SP
    7  MOVQ 0x810(SP), DI ; 8 MOVQ 0x818(SP), SI ; 9 MOVQ 0x820(SP), DX
    10 MOVQ SP, BX ; 11 ADDQ $0x800, SP ; 12 ANDQ $-0x20, SP
    13 CMPB hasShani,1 / JE ; CMPB hasAVX512,1 / JE ; CMPB hasAVX2,1 / JE                [dispatch]
       CALL <kernel>                                                                       [call]
    MOVQ BX, SP ; ADDQ $0x800, SP ; POPQ BP ; RET

`pre` is instructions 1, 4–11 (12, the alignment, is executed by `alignStep`); `post` the epilogue.
The dispatch is a function of the three flag bytes (Go bools: the `JE` is taken iff the byte is 1).
-/

namespace Hashtree.Kernels.X86.WrapperLinux
open Hashtree.Asm Hashtree.Asm.X86

def pre : Array Instr := #[
  .lea 12 { base := some 4, disp := -0x788 },
  .push 5,
  .mov 64 5 (.reg 4),
  .sub 64 4 (.imm 0x800),
  .mov 64 7 (.mem { base := some 4, disp := 0x810 }),
  .mov 64 6 (.mem { base := some 4, disp := 0x818 }),
  .mov 64 2 (.mem { base := some 4, disp := 0x820 }),
  .mov 64 3 (.reg 4),
  .alu .add 64 4 (.imm 0x800)]

def alignI : Instr := .alu .and 64 4 (.imm (-0x20))

def post : Array Instr := #[
  .mov 64 4 (.reg 3),
  .alu .add 64 4 (.imm 0x800),
  .pop 5,
  .ret]

/-- The kernels the wrapper can call. -/
inductive Kern | shani | avx512 | avx2 | avx1
  deriving DecidableEq, Repr

/-- `CMPB hasShani, 1; JE shani; CMPB hasAVX512, 1; JE avx512; CMPB hasAVX2, 1; JE avx2; CALL avx_x1`. -/
def pick (hasShani hasAVX512 hasAVX2 : Bool) : Kern :=
  if hasShani then .shani else if hasAVX512 then .avx512 else if hasAVX2 then .avx2 else .avx1

end Hashtree.Kernels.X86.WrapperLinux
