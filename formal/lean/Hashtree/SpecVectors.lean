import Hashtree.Spec

/-! Test vectors for `Spec.sha256` (expected digests from Python hashlib / FIPS 180-2 examples). -/

namespace Hashtree.SpecVectors
open Hashtree.Spec

def hexByte (s : String) (i : Nat) : Byte :=
  let d (c : Char) : Nat := if c.isDigit then c.toNat - 48 else c.toNat - 87
  BitVec.ofNat 8 (16 * d (s.toList.getD (2*i) '0') + d (s.toList.getD (2*i+1) '0'))
def unhex (s : String) : List Byte := (List.range (s.length / 2)).map (hexByte s)

