/-- The entry live set of the avx_x1 link (`[4, 3, 8, 6, 7, 5, 12, 13, 14, 15, 1, 2]`). -/
abbrev L1 : List Nat := Hashtree.Proofs.WinAvxX1Live.liveT.getD 0 []

/-- **The avx_x4 link obligation**: from the wrapper's call state, after `s4 c` steps the link
has no error and either returned (`c = 0`, at pc 3, before the frame is set up: no writes) or
tail-called `hashtree_sha256_avx_x1` with `c - c % 4` blocks done and `c % 4` remaining, its
frame cells (depth 568) in the hand-off log. -/
def KSpecC4 (s4 : Nat → Nat) (env : Key → W32) (σ : Nat → Int) (m0 : Addr Int → Cell W32 Int)
    (orcC : Nat → Bool) (c : Nat) (inp : Nat → Spec.Byte) : Prop :=
  WfMemW Hashtree.Kernels.X86Win.AvxX4.rodata [] env σ m0 → EnvMem env σ m0 → σ 2 = c →
  (∀ o : Nat, m0 ⟨rIn, σ 0 + o⟩ = .dat ((inp o).zeroExtend 32) 0) →
  ∀ s, s = mapState env σ entryWin →
    let f := run p4 4 m0 orcC (s4 c) s
    f.err = none ∧
      ((c = 0 ∧ f.tail = none ∧ PostLink σ c inp 0 f) ∨
       (c ≠ 0 ∧ f.tail = some "hashtree_sha256_avx_x1" ∧
         PreLink env σ c (c - c % 4) (c % 4) inp 568 L1 (resume f)))

