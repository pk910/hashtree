set_option maxRecDepth 200000
set_option maxHeartbeats 0
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

open Hashtree.Asm Hashtree.Asm.X86 Hashtree.Asm.X86Sym Hashtree.Asm.X86SymW
open Hashtree.Kernels.X86Win.AvxX4
open Hashtree.Gen.WinAvxX4P
open Hashtree.Proofs.AvxX4W (shiftA shiftV shiftC)
open Hashtree.Proofs.WinWrapper (entryWin)

/-!
# The windows `avx_x4` pilot cuts rebased on the wrapper call state

The fixed-count windows pilot `Gen/WinAvxX4P` (count 4, 203 slices `K1 .. K204`) is stated at
`entrySW 24`: the stack pointer is the constant `24`.  The windows wrapper calls the kernel at
`WinWrapper.entryWin` (`rcx`/`rdx`/`r8` = output/input/count, `rsp = sAt 0` with the return
marker at `σ 9`, the callee-saved registers pointer-tagged on symbols `5, 6, 7, 11, 8, 12`).
The kernel has no alignment instruction, so a pilot stack offset `k` is uniformly `sAt (k - 24)`
at the call state (`AvxX4W.shiftA`), and the only other difference between the two states is
the registers the kernel never writes: `rbx, rbp, r12..r15` take the wrapper's pointers
(`wRegW`); `rax` (the table pointer) and `r9` (the round counter) are written before they are
read, and `rsi, rdi, r10, r11` keep their numbered variables.  The ten `xmm6..15` saves of the
prologue are data cells in every cut's log in both states, so `shiftC` only moves them.

`shiftKW` is that rebasing; the pass-1 body slices at the rebased cuts are generated by
`tools/winx4w.py` (`WinAvxX4WBodyP1..P4`, `WinAvxX4WBody`).  This file has the entry slice
(`entryWin` to the rebased `K1`, eight instructions), the loop tail (`K203` back to the body
head at pc 17, 25 instructions: the 23-instruction tail with `jmp 15`, `cmp r8,4; jl` not
taken) and the exit (`jl` taken: the ten `xmm` restores, `add rsp,568`, `jmp avx_x1`, 37
instructions), with their kernel facts.
-/

namespace Hashtree.Proofs.WinAvxX4W

/-- The wrapper-call symbolic memory: the kernel's table in region 4, nothing pushed. -/
def m0W : Addr Lin → Cell E Lin := mem0qW 4 roC []

theorem m0W_eq : m0W = mem0sW 4 rodata [] :=
  mem0qW_eq 4 rodata [] roC 36 roC_eq (by decide +kernel)

theorem m0W_keyed : MemKeyed m0W :=
  mem0qW_keyed 4 rodata [] roC 36 roC_eq (by decide +kernel) (by decide +kernel)

/-- The wrapper call value of a register the kernel never writes. -/
def wRegW : Nat → Val E Lin
  | 3 => .ptr ⟨rStack, Lin.sym 5⟩
  | 5 => .ptr ⟨rStack, Lin.sym 6⟩
  | 12 => .ptr ⟨rNum, Lin.sym 7⟩
  | 13 => .ptr ⟨rNum, Lin.sym 11⟩
  | 14 => .ptr ⟨rG, Lin.sym 8⟩
  | 15 => .ptr ⟨rNum, Lin.sym 12⟩
  | _ => .num (.const 0) (.const 0)

/-- A pilot cut rebased on the wrapper call state. -/
def shiftKW (K : State E Lin) : State E Lin :=
  let g := K.gpr.map shiftV
  let g2 := (((((g.set 3 (wRegW 3)).set 5 (wRegW 5)).set 12 (wRegW 12)).set 13 (wRegW 13)).set 14
    (wRegW 14)).set 15 (wRegW 15)
  { K with gpr := g2, mem := K.mem.map (fun p => (shiftA p.1, shiftC p.2)) }

/-! ## The entry conditions -/

/-- The prologue's recorded condition: the count is nonzero. -/
def A0e : List (Cond Lin × Bool) :=
  [((.not (.eq (⟨0, [0, 0, 1]⟩ : Lin) (⟨0, []⟩ : Lin))), true)]

/-- The body cuts' conditions: `c < 4` false, `c ≠ 0` true. -/
def A0 : List (Cond Lin × Bool) :=
  [((.lt (⟨0, [0, 0, 1]⟩ : Lin) (⟨4, []⟩ : Lin)), false),
   ((.not (.eq (⟨0, [0, 0, 1]⟩ : Lin) (⟨0, []⟩ : Lin))), true)]

/-- After a turn: the residual count's `jl` (not taken) on top of `A0`. -/
def AT : List (Cond Lin × Bool) :=
  ((.lt (⟨-4, [0, 0, 1]⟩ : Lin) (⟨4, []⟩ : Lin)), false) :: A0

/-- At the exit: the residual count's `jl` (taken) on top of `A0`. -/
def AX : List (Cond Lin × Bool) :=
  ((.lt (⟨-4, [0, 0, 1]⟩ : Lin) (⟨4, []⟩ : Lin)), true) :: A0

theorem asmNZ (σ : Nat → Int) (h0 : 0 < σ 2) :
    ∀ p ∈ A0e, (mapCond σ p.1).decideC = some p.2 := by
  intro p hp
  simp only [A0e, List.mem_cons, List.mem_nil_iff, or_false] at hp
  rcases hp with rfl
  simp [mapCond, Cond.decideC, Lin.eval, dotC, Ctl.sub, Ctl.add, Ctl.smul, Ctl.asInt]
  omega

theorem asmge (σ : Nat → Int) (hge : 4 ≤ σ 2) :
    ∀ p ∈ A0, (mapCond σ p.1).decideC = some p.2 := by
  intro p hp
  simp only [A0, List.mem_cons, List.mem_nil_iff, or_false] at hp
  rcases hp with rfl | rfl
  · simp [mapCond, Cond.decideC, Lin.eval, dotC, Ctl.sub, Ctl.add, Ctl.smul, Ctl.asInt]
    omega
  · simp [mapCond, Cond.decideC, Lin.eval, dotC, Ctl.sub, Ctl.add, Ctl.smul, Ctl.asInt]
    omega

theorem asmT (σ : Nat → Int) (hge : 8 ≤ σ 2) :
    ∀ p ∈ AT, (mapCond σ p.1).decideC = some p.2 := by
  intro p hp
  simp only [AT, A0, List.mem_cons, List.mem_nil_iff, or_false] at hp
  rcases hp with rfl | rfl | rfl <;>
    simp [mapCond, Cond.decideC, Lin.eval, dotC, Ctl.sub, Ctl.add, Ctl.smul, Ctl.asInt] <;>
    omega

theorem asmX (σ : Nat → Int) (hge : 4 ≤ σ 2) (hlt : σ 2 < 8) :
    ∀ p ∈ AX, (mapCond σ p.1).decideC = some p.2 := by
  intro p hp
  simp only [AX, A0, List.mem_cons, List.mem_nil_iff, or_false] at hp
  rcases hp with rfl | rfl | rfl <;>
    simp [mapCond, Cond.decideC, Lin.eval, dotC, Ctl.sub, Ctl.add, Ctl.smul, Ctl.asInt] <;>
    omega

/-! ## Oracles -/

/-- `jne` at pc 2 taken (count nonzero). -/
def orcE : Nat → Bool := fun pc => decide (pc ∈ ([2] : List Nat))
/-- No branch taken. -/
def orcB : Nat → Bool := fun _ => false
/-- `jl` at pc 16 taken (the loop exit). -/
def orcEx : Nat → Bool := fun pc => decide (pc ∈ ([16] : List Nat))

/-! ## The cuts -/

/-- The rebased first cut: `K1`'s flags come from `sub rsp,568`, whose first operand is the
stack pointer, so they move with it (`sAt 0` for the pilot's `24`); every later cut's flags
come from `cmp r8,4`. -/
def K1W : State E Lin := { shiftKW K1 with flags := some (sAt 0, ⟨568, []⟩) }

/-- The entry: eight instructions (`nop; cmp r8,0; jne; sub rsp,568` and the first four `xmm`
saves) from the wrapper call state to the rebased `K1` (pc 9). -/
theorem sliceE : sliceCheck prog 4 m0W orcE 8 entryWin K1W T0 = true := by
  decide +kernel

/-- The first body slice (the remaining saves, `cmp r8,4`, `jl` not taken) from the rebased
`K1` to the rebased `K2`. -/
theorem sliceE1 : sliceCheck prog 4 m0W orcB 8 K1W (shiftKW K2) T1 = true := by
  decide +kernel

theorem entryWin_err : entryWin.err = none := rfl

/-- The turn's end: the loop tail and the re-entry to the body head (pc 17). -/
def KT : State E Lin := abstract (run prog 4 m0W orcB 25 (shiftKW K203))

/-- The exit: the loop tail with `jl` taken, the restores and the tail call. -/
def KTE : State E Lin := abstract (run prog 4 m0W orcEx 37 (shiftKW K203))

/-- The general registers at the exit: the wrapper call state's with the output, input and
count advanced by one batch, `rax` on the table and the round counter `r9` at its final value. -/
def exitGprW : List (Val E Lin) :=
  ((((entryWin.gpr.set 1 (.ptr ⟨rOut, ⟨128, [0, 1]⟩⟩)).set 2 (.ptr ⟨rIn, ⟨256, [1]⟩⟩)).set 8
    (.ptr ⟨rNum, ⟨-4, [0, 0, 1]⟩⟩)).set 0 (.ptr ⟨4, ⟨1024, []⟩⟩)).set 9 (.ptr ⟨rNum, ⟨1024, []⟩⟩)

/-- The pass-1 tail and exit facts, one kernel evaluation. -/
def tailOk : Bool :=
  sliceCheck prog 4 m0W orcB 25 (shiftKW K203) KT [] &&
  decide (KT.pc = 17) && decide (KT.err = none) && decide (KT.halted = false) &&
  decide (KT.assume = AT) &&
  sliceCheck prog 4 m0W orcEx 37 (shiftKW K203) KTE [] &&
  decide (KTE.pc = 4162) && decide (KTE.err = none) && decide (KTE.halted = true) &&
  decide (KTE.tail = some "hashtree_sha256_avx_x1") && decide (KTE.assume = AX) &&
  decide (KTE.gpr = exitGprW)

theorem tailOk_true : tailOk = true := by decide +kernel

end Hashtree.Proofs.WinAvxX4W
