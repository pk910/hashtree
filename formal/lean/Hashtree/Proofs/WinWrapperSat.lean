import Hashtree.Proofs.WinWrapper

/-!
# R5: the windows wrapper's hypotheses are satisfiable

`WinWrapper.wrapper_kernelW_fixed` / `wrapper_kernelW_shipped` take the kernel memory
hypotheses (`WfMemW rodata argCells`, `EnvMem`, the input bytes) and the alignment identity
`hA`.  This file exhibits a concrete memory and stack pointer for which they all hold, for
**any** aligned call `rsp` `A`: the ABI0 return address at `[SPe, SPe+8)`, the three argument
slots at `[SPe+8, SPe+32)` (output/input/count), the input bytes, and rodata.

`σ 10` is set to `A - 8`, so the two frame theorems' `hA` is the caller's choice of `A`:
`A = (σ 9 - 8) - (σ 9 - 8) % 32` for the fixed frame (`$2048`), and
`A = (σ 9 + 1016) - (σ 9 + 1016) % 32` for the shipped one (`$1024`); the two corollaries
below plug those in.  Nothing here depends on the kernel: it is the wrapper's own input
contract.
-/

set_option maxHeartbeats 0
set_option linter.deprecated false

namespace Hashtree.Proofs.WinWrapper
open Hashtree.Asm Hashtree.Asm.X86 Hashtree.Asm.X86Sym Hashtree.Asm.X86SymW
open Hashtree.Asm.SpecQ Hashtree.Spec
open Hashtree.Kernels.X86Win.WrapperWindows
open Hashtree.Proofs.WrapperAmd64 (argCells)

/-- The ABI0 argument slots (the autogenerated wrapper stored output, input, count at
`SPe+8`, `SPe+16`, `SPe+24`; the same layout as the linux wrapper's `argCells`). -/
def argSpecW (k : Int) : Cell E Lin :=
  if k < 16 then .pb ⟨rOut, Lin.sym 1⟩ (k - 8).toNat
  else if k < 24 then .pb ⟨rIn, Lin.sym 0⟩ (k - 16).toNat
  else .pb ⟨rNum, Lin.sym 2⟩ (k - 24).toNat

theorem argCells_specW : ∀ p ∈ argCells, 8 ≤ p.1 ∧ p.1 < 32 ∧ p.2 = argSpecW p.1 := by
  decide +kernel

/-- A concrete memory meeting the wrapper's `WfMemW`: rodata, the return address at `SPe`, the
three argument slots, and the input bytes. -/
def cmemWrW (rodata : List Nat) (σ : Nat → Int) (inp : Int → W32) : Addr Int → Cell W32 Int := fun a =>
  if a.region = 4 then .dat (BitVec.ofNat 32 (rodata.getD a.off.toNat 0)) 0
  else if a.region = rStack then
    if σ 9 ≤ a.off ∧ a.off < σ 9 + 8 then .pb ⟨rRet, 0⟩ (a.off - σ 9).toNat
    else if σ 9 + 8 ≤ a.off ∧ a.off < σ 9 + 32 then
      mapCell (fun _ => 0) σ (argSpecW (a.off - σ 9))
    else .dat 0 0
  else if a.region = rIn then .dat (inp a.off) 0
  else .dat 0 0

/-- **The wrapper's kernel-memory hypotheses are satisfiable**, for any aligned call `rsp` `A`:
with `σ 10 = A - 8`, the concrete memory `cmemWrW` meets `WfMemW rodata argCells`, the
environment memory is `ecomb env σ m`, the count is `c`, the input bytes are in place, and the
alignment identity holds by construction. -/
theorem wrapper_hyps_satW (rodata : List Nat) (A : Int) (c : Nat) (inp : Nat → Byte)
    (env : Key → W32) (σ0 : Nat → Int) (hc : σ0 2 = c) :
    let σ : Nat → Int := fun i => if i = 10 then A - 8 else σ0 i
    let m := cmemWrW rodata σ (fun x => (inp (x - σ 0).toNat).zeroExtend 32)
    WfMemW rodata argCells (ecomb env σ m) σ m ∧ EnvMem (ecomb env σ m) σ m ∧ σ 2 = c ∧
      (∀ o : Nat, m ⟨rIn, σ 0 + o⟩ = .dat ((inp o).zeroExtend 32) 0) ∧ σ 10 + 8 = A := by
  intro σ m
  refine ⟨⟨fun o => ?_, fun k h1 h2 => ?_, fun o => ?_, fun k cl hl h8 _ => ?_⟩,
    envMem_ecomb _ _ _, ?_, fun o => ?_, ?_⟩
  · simp [m, cmemWrW]
  · simp only [m, cmemWrW, rStack, show (3 : Region) ≠ 4 from by decide, ite_false, ite_true]
    rw [if_pos ⟨by omega, by omega⟩]
    congr 2
    omega
  · simp only [m, cmemWrW, rIn, rStack, show (1 : Region) ≠ 4 from by decide,
      show (1 : Region) ≠ 3 from by decide, ite_false, ite_true, cellX]
  · obtain ⟨h1, h2, h3⟩ := argCells_specW _ (plookup_mem k argCells cl hl)
    simp only at h1 h2 h3
    subst h3
    simp only [m, cmemWrW, rStack, show (3 : Region) ≠ 4 from by decide, ite_false, ite_true]
    rw [if_neg (by omega), if_pos ⟨by omega, by omega⟩, show σ 9 + k - σ 9 = k by omega]
    simp only [argSpecW]
    split <;> (try split) <;> simp [mapCell, mapAddr, Lin.eval_sym]
  · show σ0 2 = c
    exact hc
  · simp only [m, cmemWrW, rIn, rStack, show (1 : Region) ≠ 4 from by decide,
      show (1 : Region) ≠ 3 from by decide, ite_false, ite_true]
    congr 3
    omega
  · simp only [σ, ite_true]
    omega

/-- The fixed frame (`$2048`): `A = (σ 9 - 8) - (σ 9 - 8) % 32`. -/
theorem wrapper_hyps_satW_fixed (rodata : List Nat) (c : Nat) (inp : Nat → Byte)
    (env : Key → W32) (σ0 : Nat → Int) (hc : σ0 2 = c) :
    let σ : Nat → Int := fun i => if i = 10 then ((σ0 9 - 8) - (σ0 9 - 8) % 32) - 8 else σ0 i
    let m := cmemWrW rodata σ (fun x => (inp (x - σ 0).toNat).zeroExtend 32)
    WfMemW rodata argCells (ecomb env σ m) σ m ∧ EnvMem (ecomb env σ m) σ m ∧ σ 2 = c ∧
      (∀ o : Nat, m ⟨rIn, σ 0 + o⟩ = .dat ((inp o).zeroExtend 32) 0) ∧
      σ 10 + 8 = (σ 9 - 8) - (σ 9 - 8) % 32 := by
  exact wrapper_hyps_satW rodata ((σ0 9 - 8) - (σ0 9 - 8) % 32) c inp env σ0 hc

/-- The shipped frame (`$1024`): `A = (σ 9 + 1016) - (σ 9 + 1016) % 32`. -/
theorem wrapper_hyps_satW_shipped (rodata : List Nat) (c : Nat) (inp : Nat → Byte)
    (env : Key → W32) (σ0 : Nat → Int) (hc : σ0 2 = c) :
    let σ : Nat → Int := fun i => if i = 10 then ((σ0 9 + 1016) - (σ0 9 + 1016) % 32) - 8 else σ0 i
    let m := cmemWrW rodata σ (fun x => (inp (x - σ 0).toNat).zeroExtend 32)
    WfMemW rodata argCells (ecomb env σ m) σ m ∧ EnvMem (ecomb env σ m) σ m ∧ σ 2 = c ∧
      (∀ o : Nat, m ⟨rIn, σ 0 + o⟩ = .dat ((inp o).zeroExtend 32) 0) ∧
      σ 10 + 8 = (σ 9 + 1016) - (σ 9 + 1016) % 32 := by
  exact wrapper_hyps_satW rodata ((σ0 9 + 1016) - (σ0 9 + 1016) % 32) c inp env σ0 hc

end Hashtree.Proofs.WinWrapper
