import Hashtree.Kernels.X86.WrapperLinux
import Hashtree.Kernels.X86.Shani

/-!
# The wrapper's ABI0 entry state (symbolic)

Symbols: 0 input, 1 output, 2 count, 3, 4 the flags at entry, 6 the caller's frame pointer,
8 g, 9 `SPe` (the stack pointer at entry; the return address into the ABIInternal wrapper is at
`SPe`, the arguments at `SPe + 8`, `+ 16`, `+ 24`).  ABIInternal argument registers: rax = output,
rbx = input, rcx = count; r14 = g; rbp = the caller's frame pointer; r13, r15 the caller's integers
(symbols 11, 12, `rNum`-tagged); other registers numbers.
-/

namespace Hashtree.Proofs.WrapperAmd64
open Hashtree.Asm Hashtree.Asm.X86 Hashtree.Asm.X86Sym Hashtree.Asm.X86SymW
open Hashtree.Kernels.X86.WrapperLinux

def wEntry : State E Lin :=
  let g := (List.range 16).map fun i =>
    if i = 4 then Val.ptr ⟨rStack, sAt 0⟩
    else if i = 0 then Val.ptr ⟨rOut, Lin.sym 1⟩
    else if i = 3 then Val.ptr ⟨rIn, Lin.sym 0⟩
    else if i = 1 then Val.ptr ⟨rNum, Lin.sym 2⟩
    else if i = 5 then Val.ptr ⟨rStack, Lin.sym 6⟩
    else if i = 14 then Val.ptr ⟨rG, Lin.sym 8⟩
    else if i = 13 then Val.ptr ⟨rNum, Lin.sym 11⟩
    else if i = 15 then Val.ptr ⟨rNum, Lin.sym 12⟩
    else Val.num (.var (.n (gId i 0))) (.var (.n (gId i 1)))
  { gpr := g, vr := (List.range 32).map (fun i => (List.range 16).map fun l => .var (.n (vId i l))),
    flags := some (Lin.sym 3, Lin.sym 4), mem := [], pc := 0, halted := false, tail := none, err := none,
    assume := [] }

/-- The argument slots (the autogenerated wrapper stored rax, rbx, rcx at `SPe + 8 ..`). -/
def argCells : List (Int × Cell E Lin) :=
  ((List.range 8).map fun k => ((8 + k : Nat) : Int) |> fun o => (o, Cell.pb ⟨rOut, Lin.sym 1⟩ k)) ++
  ((List.range 8).map fun k => ((16 + k : Nat) : Int) |> fun o => (o, Cell.pb ⟨rIn, Lin.sym 0⟩ k)) ++
  ((List.range 8).map fun k => ((24 + k : Nat) : Int) |> fun o => (o, Cell.pb ⟨rNum, Lin.sym 2⟩ k))

/-- The wrapper's symbolic initial memory: as a kernel call's (`mem0sW`), with its arguments as the
stack bytes above the return address, and rodata poison (the wrapper reads none; this keeps the
prefix independent of the kernel). -/
def m0W : Addr Lin → Cell E Lin := fun a => if a.region = 4 then poison else mem0sW 4 [] argCells a

theorem m0W_rel (rodata : List Nat) (env : Key → W32) (σ : Nat → Int) (m : Addr Int → Cell W32 Int)
    (hw : WfMemW rodata argCells env σ m) (he : EnvMem env σ m) : Mem0Rel env σ m0W m := by
  have h := mem0RelW_of_wf rodata argCells env σ m hw he
  intro a ha
  obtain ⟨r, off⟩ := a
  by_cases h4 : r = 4
  · subst h4; simp [m0W, poison, Cell.okC] at ha
  · have e : m0W ⟨r, off⟩ = mem0sW 4 rodata argCells ⟨r, off⟩ := by
      simp only [m0W, h4, ite_false, mem0sW, mem0s]
    rw [e] at ha ⊢; exact h _ ha

theorem m0W_keyed : MemKeyed m0W := by
  intro a
  simp only [m0W]
  split
  · exact Or.inr (Or.inr ⟨_, _, rfl⟩)
  · exact mem0sW_keyed 4 [] argCells (by decide) a

end Hashtree.Proofs.WrapperAmd64
